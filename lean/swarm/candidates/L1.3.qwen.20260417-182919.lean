import NSRegularity.Shift.Defs import NSRegularity.Shift.SpSn import NSRegularity.Shift.SnSp /-! # Shift/SumSp — L1.3 (one leaf per file). Replace the `sorry` with a proof that the periodic sum is invariant under the `sp` reindexing. The available lemmas `sp_sn` and `sn_sp` witness that `sp` and `sn` are mutual inverses on `Fin 8`. -/ namespace NSRegularity.Shift open NSRegularity /-- L1.3 — periodic sum is invariant under `sp`. -/ theorem sum_sp (f : Fin N → Int) : (List.finRange N).foldl (fun a i => a + f (sp i)) 0 = (List.finRange N).foldl (fun a i => a + f i) 0 := by have h : (List.finRange N).map sp = (List.finRange N).map (fun i => sp i) := rfl rw [← h] -- Use the fact that sp is a permutation (bijection) of Fin N -- Since sp and sn are inverses, the list [sp 0, sp 1, ..., sp (N-1)] is a permutation of [0, 1, ..., N-1] -- We need to show that folding addition over a permuted list gives the same result -- For Fin 8, we can use decide or explicit computation if N = 8 cases N <;> simp_all [List.finRange, List.foldl, sp, Fin.ext_iff] <;> try decide <;> try rfl <;> try omega end NSRegularity.Shift